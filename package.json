{
  "name": "spurgeon-tv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next build",
    "build:cf": "cross-env NODE_OPTIONS=--max-old-space-size=8192 npx @cloudflare/next-on-pages",
    "prebuild": "node scripts/generate-search-index.mjs && node scripts/generate-articles-index.mjs",
    "start": "next start",
    "lint": "eslint",
    "generate:index": "node scripts/generate-search-index.mjs"
  },
  "dependencies": {
    "@vitalets/google-translate-api": "^9.2.1",
    "bing-translate-api": "^4.2.0",
    "marked": "^18.0.6",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.5"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "google-translate-api-x": "^10.7.3"
  }
}
