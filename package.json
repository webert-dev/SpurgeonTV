{
  "name": "spurgeon-tv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev -H 0.0.0.0 -p 3000",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next build",
    "prebuild": "node scripts/generate-search-index.mjs && node scripts/generate-devotional-pages.mjs && node scripts/generate-sermon-pages.mjs && node scripts/generate-articles-index.mjs && node scripts/copy-sermons.mjs && node scripts/generate-sitemap.mjs",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "generate:index": "node scripts/generate-search-index.mjs",
    "translate:es": "node scripts/translate-es-batch.js",
    "translate:devotional": "node scripts/translate-devotional.js",
    "translate:devotional:all": "node scripts/translate-devotional.js --all"
  },
  "dependencies": {
    "marked": "^18.0.6",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "bing-translate-api": "^4.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10"
  }
}
