{"sermons":[{"title":"Sermon 3286 | The Fear of Death","slug":"sermon_3286","volume":"volume-58","volumeNum":58,"scripture":{"verse":"Humble, teachable and mild,","reference":"Like unto a little child."},"isTranslated":true},{"title":"Sermon 3287 | The Only Door","slug":"sermon_3287","volume":"volume-58","volumeNum":58,"scripture":null,"isTranslated":true},{"title":"Sermon 3288 | Why the Gospel Is Hidden","slug":"sermon_3288","volume":"volume-58","volumeNum":58,"scripture":null,"isTranslated":true},{"title":"Sermon 3289 | The Sealed Hand&mdash;a Winter Sermon","slug":"sermon_3289","volume":"volume-58","volumeNum":58,"scripture":{"verse":"It needs our hearts be weaned from earth. It needs that we be driven By loss of every earthly stay,","reference":"To seek our joys in Heaven."},"isTranslated":true},{"title":"Sermon 3290 | God's Hand at Evening","slug":"sermon_3290","volume":"volume-58","volumeNum":58,"scripture":null,"isTranslated":true},{"title":"Sermon 3291 | The Sea! the Sea! the Wide and Open Sea!","slug":"sermon_3291","volume":"volume-58","volumeNum":58,"scripture":{"verse":"He formed the deeps unknown, He gave the seas their bound. The watery worlds are all His own,","reference":"And all the solid ground."},"isTranslated":true},{"title":"Sermon 3292 | The Almighty Warrior","slug":"sermon_3292","volume":"volume-58","volumeNum":58,"scripture":null,"isTranslated":true},{"title":"Sermon 3293 | \"The Blood of the Testament\"","slug":"sermon_3293","volume":"volume-58","volumeNum":58,"scripture":null,"isTranslated":true},{"title":"Sermon 3294 | The Lord's Eternal Rest","slug":"sermon_3294","volume":"volume-58","volumeNum":58,"scripture":null,"isTranslated":true}],"total":3536,"totalPages":393,"currentPage":363}