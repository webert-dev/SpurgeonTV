{"sermons":[{"title":"Sermon 88 | The Plea of Faith","slug":"sermon-88","volume":"volume-02","volumeNum":2,"scripture":{"verse":"Do as thou hast said.","reference":"2 Samuel 7:25"},"isTranslated":true},{"title":"Sermon 89 | Hatred Without Cause","slug":"sermon-89","volume":"volume-02","volumeNum":2,"scripture":{"verse":"They hated me without a cause.","reference":"John 15:25"},"isTranslated":true},{"title":"Sermon 90 | Men Chosen&mdash;Fallen Angels Rejected","slug":"sermon-90","volume":"volume-02","volumeNum":2,"scripture":{"verse":"Verily he took not on him the nature of angels; but he took on him the seed of Abraham.","reference":"Hebrews 2:16"},"isTranslated":true},{"title":"Sermon 91 | Christ Exalted","slug":"sermon-91","volume":"volume-02","volumeNum":2,"scripture":{"verse":"This man, after he had offered on sacrifice for sins for ever, sat down on the right hand of God; From henceforth expecting till his enemies be made his footstool.","reference":"Hebrews 10:12-13"},"isTranslated":true},{"title":"Sermon 92 | Profit and Loss","slug":"sermon-92","volume":"volume-02","volumeNum":2,"scripture":{"verse":"What shall it profit a man, if he shall gain the whole word, and lose his own soul?","reference":"Mark 8:36"},"isTranslated":true},{"title":"Sermon 93 | God in the Covenant","slug":"sermon-93","volume":"volume-02","volumeNum":2,"scripture":{"verse":"I will be their God.","reference":"Jeremiah 31:33"},"isTranslated":true},{"title":"Sermon 94 | Tomorrow","slug":"sermon-94","volume":"volume-02","volumeNum":2,"scripture":{"verse":"Boast not thyself of tomorrow; for thou knowest not what a day may bring forth.","reference":"Proverbs 27:1"},"isTranslated":true},{"title":"Sermon 95 | The Day of Atonement","slug":"sermon-95","volume":"volume-02","volumeNum":2,"scripture":{"verse":"This shall be an everlasting statute unto you, to make an atonement for the children of Israel for all their sins once a year.","reference":"Leviticus 16:34"},"isTranslated":true},{"title":"Sermon 96 | The Christian, a Debtor","slug":"sermon-96","volume":"volume-02","volumeNum":2,"scripture":{"verse":"Therefore, brethren, we are debtors.","reference":"Romans 8:12"},"isTranslated":true}],"total":3536,"totalPages":393,"currentPage":10}